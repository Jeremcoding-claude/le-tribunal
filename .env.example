# Modèle de configuration (plan §11.3). Copier en .env — jamais commité, jamais copié dans l'image. Aucun secret ici.
# Seules les valeurs « true » et « false » sont acceptées : une valeur douteuse arrête le démarrage.
MOCK_MODE=true
# Exigées seulement si MOCK_MODE=false (jeton : 16 caractères minimum). Ignorées en mode MOCK.
ANTHROPIC_API_KEY=
TRIBUNAL_ACCESS_TOKEN=
# Dossier de la base et des fichiers (hors Docker). Dans l'image : /data.
DATA_DIR=./data
# Compose seulement : port publié sur 127.0.0.1.
HOST_PORT=3000
